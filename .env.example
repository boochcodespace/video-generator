# Copy this file to `.env` and fill in your own keys.
# `.env` is gitignored — never commit it.

# Anthropic API key — REQUIRED for the web app (Claude generates video compositions)
# Get yours at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# OpenAI API key — needed for Whisper transcription if local whisper.cpp is not installed
# Get yours at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ClickUp API key — only needed if a project integrates with ClickUp
CLICKUP_API_KEY=
